server {
    listen [::]:80 default_server;
    listen 80 default_server;

    resolver 127.0.0.11;

    server_name _ ${DNS_BASENAME};

    # redirect root to home
    location = / {
        return 301 /home;
    }

    # default location is /storage
    location / {
        root /storage;
        autoindex on;
    }

    # static site pages
    location ~* ^/(about|home|map|projects) {
        xslt_stylesheet /etc/nginx/xslt/base.xslt;
        xslt_types text/html;
        root /var/www/static/pages;
        try_files $uri $uri.html 404;
    }

    # static website resources
    location ^~ /static {
        # because of nginx rules, this implies /var/www/static
        root /var/www;
    }
}
